# Copy to .env.local for local dev. In production, set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- Login (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000            # production: https://<your-app>.vercel.app
NEXTAUTH_SECRET=                               # openssl rand -base64 32
ALLOWED_EMAIL=you@example.com                  # the only account allowed in (comma-separate for more)
# Configure at least one login method:
DASHBOARD_PASSWORD=                            # password login for ALLOWED_EMAIL (openssl rand -base64 24)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Schwab Trader API (read-only use) ---
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://<your-app>.vercel.app/api/schwab/callback
SCHWAB_ACCOUNT_LAST4=9061

# --- Upstash Redis / Vercel KV (auto-set when you connect the store to the project) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Vercel Cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=                                   # openssl rand -hex 32

# --- Local preview only: fake Schwab data, ignored on Vercel ---
# SCHWAB_MOCK=1
